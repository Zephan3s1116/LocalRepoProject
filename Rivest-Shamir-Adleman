from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import hashes

# 1. Generate an RSA private key (2048-bit key size is standard minimum)
private_key = rsa.generate_private_key(
    public_exponent=65537,
    key_size=2048
)

# 2. Extract the public key from the private key
public_key = private_key.public_key()

# 3. Define the plaintext message to encrypt
plaintext = b"Sensitive message for RSA encryption"

# 4. Encrypt the plaintext using the Public Key and OAEP padding (secure padding choice)
ciphertext = public_key.encrypt(
    plaintext,
    padding.OAEP(
        mgf=padding.MGF1(algorithm=hashes.SHA256()),
        algorithm=hashes.SHA256(),
        label=None
    )
)
print("Encrypted Ciphertext (hex):", ciphertext.hex()[:64], "...")

# 5. Decrypt the ciphertext back to plaintext using the Private Key
decrypted_data = private_key.decrypt(
    ciphertext,
    padding.OAEP(
        mgf=padding.MGF1(algorithm=hashes.SHA256()),
        algorithm=hashes.SHA256(),
        label=None
    )
)

print("Decrypted Plaintext:", decrypted_data.decode())
