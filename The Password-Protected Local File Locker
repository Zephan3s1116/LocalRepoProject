import os
import base64
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

def derive_key(password: str, salt: bytes) -> bytes:
    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=100_000,
    )
    return kdf.derive(password.encode())

def encrypt_file(file_path: str, password: str, output_path: str):
    with open(file_path, "rb") as f:
        plaintext = f.read()
    
    salt = os.urandom(16)
    key = derive_key(password, salt)
    
    aesgcm = AESGCM(key)
    nonce = os.urandom(12)
    ciphertext = aesgcm.encrypt(nonce, plaintext, None)
    
    with open(output_path, "wb") as f:
        f.write(salt + nonce + ciphertext)
    
    print(f"File encrypted successfully and saved to: {output_path}")

def decrypt_file(encrypted_path: str, password: str, output_path: str):
    with open(encrypted_path, "rb") as f:
        file_data = f.read()
    
    salt = file_data[:16]
    nonce = file_data[16:28]
    ciphertext = file_data[28:]
    
    key = derive_key(password, salt)
    
    aesgcm = AESGCM(key)
    try:
        plaintext = aesgcm.decrypt(nonce, ciphertext, None)
        with open(output_path, "wb") as f:
            f.write(plaintext)
        print(f"File decrypted successfully and saved to: {output_path}")
    except Exception:
        print("Decryption FAILED: Incorrect password or corrupted file data.")

if __name__ == "__main__":
    sample_filename = "secret_notes.txt"
    encrypted_filename = "secret_notes.enc"
    decrypted_filename = "recovered_notes.txt"
    
    with open(sample_filename, "w") as f:
        f.write("Top Secret Project Details: Phase 1 is complete!")
    
    master_password = "SuperSafeMasterPassword123!"
    
    encrypt_file(sample_filename, master_password, encrypted_filename)
    decrypt_file(encrypted_filename, master_password, decrypted_filename)
    
    for f in [sample_filename, encrypted_filename, decrypted_filename]:
        if os.path.exists(f):
            os.remove(f)
