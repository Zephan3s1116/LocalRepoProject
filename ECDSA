from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives import hashes

# 1. Generate an ECC private key using NIST P-256 (SECP256R1) curve
private_key = ec.generate_private_key(ec.SECP256R1())

# 2. Obtain the matching public key
public_key = private_key.public_key()

# 3. Document payload
data = b"Critical security log entry"

# 4. Sign the data using ECDSA and SHA-256 hash function
signature = private_key.sign(
    data,
    ec.ECDSA(hashes.SHA256())
)
print("ECDSA Signature (hex):", signature.hex()[:64], "...")

# 5. Verify signature authenticity using the public key
try:
    public_key.verify(
        signature,
        data,
        ec.ECDSA(hashes.SHA256())
    )
    print("ECDSA Signature Verification: SUCCESS")
except Exception as err:
    print("ECDSA Signature Verification: FAILED", err)
